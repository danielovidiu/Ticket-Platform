{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && FORWARDED_ALLOW_IPS=\"\" venv/bin/uvicorn server:app --port 8000 --reload"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && PORT=3000 BROWSER=none npx --yes yarn@1.22.22 start"
      ],
      "port": 3000,
      "autoPort": false
    }
  ]
}
