# Supabase project (Settings -> API). Safe for the browser bundle — anon key is RLS-scoped.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Canonical site URL for this environment (used to build the OAuth redirect target).
VITE_SITE_URL=http://localhost:5173

# Google Analytics 4. Analytics stays a no-op unless BOTH vars are set AND the user
# accepts the cookie consent banner. See src/lib/analytics.ts.
VITE_GA_MEASUREMENT_ID=
VITE_ENABLE_ANALYTICS=false

# Comma-separated list of OAuth providers to show sign-in buttons for.
# Options: google, facebook, apple. Add facebook/apple once their provider setup is done (see SETUP.md).
VITE_ENABLED_OAUTH_PROVIDERS=google

VITE_TIMEZONE=Europe/Bucharest

# NOTE: Stripe, SmartBill/Oblio, and transactional email keys are deliberately NOT
# listed here. They will be Supabase Edge Function secrets (`supabase secrets set ...`)
# in a later ticketing/admin slice, never VITE_ browser env vars.
