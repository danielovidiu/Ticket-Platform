# ---- Core (required) ----
MONGO_URL=mongodb://localhost:27017
DB_NAME=ticket_platform_local

# Deployment environment. When "production", the app fails to start unless
# SESSION_SECRET and an explicit CORS_ORIGINS allowlist are set.
APP_ENV=development

# Public origin of the FRONTEND. OAuth callbacks and all email links point here,
# and its scheme decides session-cookie scoping (https => SameSite=None; Secure).
PUBLIC_APP_URL=http://localhost:3000

# Overrides the SameSite scoping derived from PUBLIC_APP_URL above. Set to "lax" when
# the frontend and the API share one origin — which is the case on Vercel, where /api/*
# is routed to the backend service on the same domain. The derived default is "none",
# and that sends the session cookie on cross-site requests for no benefit when they are
# same-origin (there is no CSRF token in this app — see SECURITY_AUDIT.md M3).
COOKIE_SAMESITE=

# Signs email-verification / password-reset / newsletter tokens. REQUIRED in
# production, and REQUIRED on any serverless host regardless of APP_ENV: the dev
# fallback mints a per-process secret, and one process per instance means links
# validate only when the click lands back on the instance that sent them.
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Version string stamped onto consent-log entries; bump when your ToS/Privacy change.
POLICY_VERSION=2026-07-22

# Commit reported by GET /api/health, so you can tell which build is serving traffic.
# Vercel injects VERCEL_GIT_COMMIT_SHA on its own and it wins; set this by hand elsewhere
# (a Dockerfile ARG, a CI variable). Blank just means health reports an empty commit.
GIT_COMMIT=

# Starting VAT rate as a fraction (0.21 = Romania's 21% standard rate). This is only the
# value used before anyone sets one: the live rate is editable in Admin -> Shop settings
# and applies to tickets and merchandise alike, so a statutory change needs no redeploy.
# Invoices store the rate they were issued under, so changing it never rewrites history.
VAT_RATE=0.21

# Make the phone number mandatory (set to 1). Blank/0 = collected but optional, which is
# the default. Name and surname are always required. A number that IS typed is validated
# either way — the flag only decides whether leaving it blank is allowed. Switching it on
# marks every phone-less account incomplete, and those users are asked for a number the
# next time they sign in.
REQUIRE_PHONE=

# Comma-separated CORS allowlist. MUST be explicit in production (no "*") because
# requests are credentialed. In dev, leave blank to default to PUBLIC_APP_URL.
CORS_ORIGINS=

# Promote this email to admin on every startup (bootstraps the first admin safely).
INITIAL_ADMIN_EMAIL=

# Which forwarding header, if any, carries the real client IP. Leave BLANK unless
# something in front of this app overwrites it on every request — otherwise callers
# choose their own rate-limit bucket and every limit is bypassable (SECURITY_AUDIT.md H1).
#   on Vercel:            x-vercel-forwarded-for   (set by the platform, unspoofable)
#   behind your own nginx: x-forwarded-for         (only if it REPLACES the header)
#
# !! Blank is NOT sufficient on its own when you run the uvicorn CLI. uvicorn defaults to
# !! proxy_headers=True with forwarded_allow_ips=127.0.0.1, so it rewrites
# !! request.client.host from X-Forwarded-For before this app sees the request — and this
# !! app's fallback trusts request.client.host as the socket peer. Re-verified: rotating
# !! the header walks straight through /api/contact's 5/60s limit. Pass
# !! --forwarded-allow-ips naming your real proxy, or "" when nothing fronts the app.
# !! Does not affect Vercel, which does not serve through the uvicorn CLI.
TRUSTED_IP_HEADER=

# ---- Media storage ----
# Set to a Vercel Blob read-write token to store uploads in Blob instead of ./uploads.
# Required on any host with an ephemeral or read-only filesystem. Vercel injects this
# automatically once a Blob store is connected to the project.
BLOB_READ_WRITE_TOKEN=

# ---- Connection pooling (serverless) ----
# Each instance opens its own pool, so the per-instance ceiling has to stay well under
# the cluster's connection allowance (500 on Atlas M0/M10). Motor's own default is 100.
MONGO_MAX_POOL_SIZE=5
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000

# ---- Email (optional; falls back to db.outbox + logs when unset) ----
RESEND_API_KEY=
MAIL_FROM=Supersanity <tickets@supersanity.example>

# ---- Payments ----
# Leave STRIPE_API_KEY blank (or set LOCAL_FAKE_PAYMENTS=1) to run the local fake
# payment simulator — the full reserve->pay->ticket flow works with no Stripe account.
# A real "sk_..." key switches to live Stripe and then STRIPE_WEBHOOK_SECRET is REQUIRED.
#
# !! DEVELOPMENT ONLY. In the fake simulator both /api/payments/status/{id} and
# !! /api/webhook/stripe finalize orders with NO authentication and NO signature — anyone
# !! who can reach the instance can issue themselves real tickets and a real invoice for
# !! free. The fallback is SILENT: a missing or malformed key selects it even when
# !! APP_ENV=production. Verify PAYMENTS_MODE=="stripe" on every deployed environment.
# !! See SECURITY_AUDIT.md finding C1.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
LOCAL_FAKE_PAYMENTS=1

# ---- Google OAuth (optional; button hidden until all three are set) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- Apple Sign In (optional; needs a PUBLIC https callback — not testable on localhost) ----
# NOTE: TEAM_ID / KEY_ID / PRIVATE_KEY are currently inert. They gate APPLE_ENABLED but
# nothing reads them: the flow uses response_type="code id_token" and only verifies the
# id_token, so the client-secret JWT they exist to sign is never built. You must still
# set them to switch Apple on. See SECURITY_AUDIT.md → "Dead configuration".
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=
